body:json {
  {
      "indices": [
          "veiculos",
          "judiciais-veiculos"
      ],
      "query": {
          "bool": {
              "must": [
                  {
                      "match_phrase_prefix": {
                          "search_terms": "fiat"
                      }
                  }
              ],
              "filter": [
                  {
                      "bool": {
                          "should": [
                              {
                                  "bool": {
                                      "must": [
                                          {
                                              "term": {
